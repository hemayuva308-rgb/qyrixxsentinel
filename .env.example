# QYRIX SENTINEL - example configuration. Copy to .env and replace EVERY value. Never commit .env.
# Values starting with CHANGE_ME are refused by the backend (auth fails closed), so copying this file cannot log anyone in.
# Generate tokens with:  openssl rand -hex 32

# --- Authentication (minimum 24 characters each) ---
# Bootstrap operator tokens for the DEFAULT tenant (admin and agent roles). After bootstrap, prefer per-person / per-agent
# API keys (POST /api/v1/sentinel/keys, roles: owner, admin, security_reviewer, approver, auditor, integrator, agent).
QYRIX_ADMIN_TOKEN=CHANGE_ME_admin_token_generate_with_openssl
QYRIX_AGENT_TOKEN=CHANGE_ME_agent_token_generate_with_openssl
# Platform operator: creates/disables tenants and issues bootstrap keys. Has NO access to any tenant's data. Empty = disabled.
QYRIX_PLATFORM_TOKEN=
# 1 = allow tenants other than "default". Refused unless PostgreSQL persistence is configured (fail closed).
QYRIX_MULTI_TENANT=0

# --- Console sessions (the browser only ever holds an httpOnly qss_ session cookie) ---
QYRIX_SESSION_TTL_SECONDS=28800
QYRIX_SESSION_IDLE_SECONDS=1800

# --- Abuse controls (per process; see docs/DEPENDENCY_AUDIT.md for multi-replica caveats) ---
QYRIX_RATE_LIMIT_PER_MIN=1200
QYRIX_AUTH_FAIL_PER_MIN=20
QYRIX_AUTH_FAIL_GLOBAL_PER_MIN=300

# --- Monitoring: Prometheus text at GET /api/v1/metrics with this bearer token. Empty = endpoint disabled. ---
QYRIX_METRICS_TOKEN=

# --- PostgreSQL persistence (provenance, approvals, evaluations, grants, proof mirror, anchors) ---
# Docker Compose: database passwords are NOT configured here. They are Docker secrets in ./secrets/ (git-ignored):
# db_admin_password (db + one-shot migrate ONLY) and db_runtime_password (least-privilege backend login). See secrets/README.md.
# Without Docker (optional; unset = in-memory mode): set QYRIX_DB_HOST (+ QYRIX_DB_PORT, QYRIX_DB_NAME, QYRIX_DB_USER) and
# QYRIX_DB_PASSWORD_FILE=<path to a file containing the password>. A missing, empty or CHANGE_ME secret => Gate blocks (R17).
QYRIX_DB_HOST=
QYRIX_DB_PASSWORD_FILE=

# --- Silent data-loss detection (docs/DISASTER_RECOVERY.md) ---
# After the FIRST start, copy the install id from `GET /api/v1/ready` logs / `python -m app.recovery status` here.
# Then even a loss of database + chain + witness together is detected (EXPECTED_INSTALLATION_MISSING).
QYRIX_EXPECTED_INSTALL_ID=

# --- External proof anchoring (RFC 3161). Needs backend egress: docker-compose.egress.yml ---
# Leave empty => anchoring NOT_CONFIGURED, verification stays PARTIAL_UNANCHORED.
QYRIX_TSA_URL=
# PEM CA certificate(s) of that TSA, as a path INSIDE the backend container (mount it read-only).
QYRIX_TSA_CA_FILE=

# --- Execution Gate policy ---
# Comma-separated destination allowlist. Empty = built-in defaults (api.render.com, github.com, docs.python.org).
QYRIX_APPROVED_DOMAINS=
# 1 = enable /reset and /benchmark (they wipe evidence). Use ONLY for demo/evaluation environments.
QYRIX_ENABLE_DEMO_RESET=0
# Approval lifetime (seconds) and grant lifetime (seconds).
QYRIX_APPROVAL_TTL_SECONDS=900
QYRIX_GRANT_TTL_SECONDS=120

# --- Public homepage demo (isolated, fixed scenarios, no egress) ---
# 0 disables POST /api/v1/demo/run entirely.
QYRIX_PUBLIC_DEMO=1
# Max demo runs per client per minute, and across all clients per minute.
QYRIX_DEMO_RATE_PER_MIN=20
QYRIX_DEMO_GLOBAL_RATE_PER_MIN=600

# --- Meta Llama (ADVISORY ONLY; never authorises execution). Leave empty to use the labelled heuristic. ---
META_API_KEY=
META_MODEL=
BASETEN_API_KEY=
BASETEN_MODEL=

# --- Frontend ---
# Public contact address used by /contact (build-time, visible to everyone). Empty = contact shows NOT CONFIGURED.
NEXT_PUBLIC_CONTACT_EMAIL=
# Set to 1 when served over HTTPS so the session cookie is Secure.
QYRIX_COOKIE_SECURE=0
