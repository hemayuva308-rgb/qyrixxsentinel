# Copy to `.env` (repo root for docker compose, or backend/.env when running without Docker).
# NEVER commit the real .env. Generate each token with:  openssl rand -hex 32

QYRIX_ADMIN_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32
QYRIX_AGENT_TOKEN=CHANGE_ME_generate_a_different_token

# Comma-separated destination allowlist for the Execution Gate
QYRIX_APPROVED_DOMAINS=api.render.com,github.com,docs.python.org

# Set to 1 only for demo/eval runs
QYRIX_ENABLE_DEMO_RESET=0

# Meta AI classifier (advisory only). Leave empty to use the labelled heuristic fallback.
META_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1

# Optional Baseten fallback provider
BASETEN_API_KEY=
BASETEN_MODEL=

QYRIX_LLM_TIMEOUT_SECONDS=30
QYRIX_LLM_MAX_INPUT_CHARS=4000
QYRIX_COOKIE_SECURE=0
